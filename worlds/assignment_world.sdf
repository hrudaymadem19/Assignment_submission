<?xml version="1.0" ?>

<sdf version="1.9">

  <world name="assignment_world">

 

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>


   
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">

      <render_engine>ogre2</render_engine>

    </plugin>

    <!-- Required for the IMU sensor -->
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu"/>


    
    <light
      type="directional"
      name="sun">

      <cast_shadows>true</cast_shadows>

      <pose>10 0 10 0 0 0</pose>

      <diffuse>0.8 0.8 0.8 1</diffuse>

      <specular>0.2 0.2 0.2 1</specular>

      <direction>-0.5 0.1 -0.9</direction>

    </light>


   
    <model name="ground_plane">

      <static>true</static>

      <pose>10 0 -0.05 0 0 0</pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>
              <size>25 12 0.1</size>
            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>
              <size>25 12 0.1</size>
            </box>

          </geometry>


          <material>

            <ambient>0.5 0.5 0.5 1</ambient>

            <diffuse>0.7 0.7 0.7 1</diffuse>

            <specular>0.1 0.1 0.1 1</specular>

          </material>

        </visual>

      </link>

    </model>


   
    <model name="north_wall">

      <static>true</static>

      <pose>10 3.15 1.5 0 0 0</pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>
              <size>20 0.3 3</size>
            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>
              <size>20 0.3 3</size>
            </box>

          </geometry>


          <material>

            <ambient>0.6 0.6 0.6 1</ambient>

            <diffuse>0.8 0.8 0.8 1</diffuse>

            <specular>0.1 0.1 0.1 1</specular>

          </material>

        </visual>

      </link>

    </model>


    <model name="south_wall">

      <static>true</static>

      <pose>10 -3.25 1.5 0 0 0</pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>
              <size>20 0.5 3</size>
            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>
              <size>20 0.5 3</size>
            </box>

          </geometry>


          <material>

            <ambient>0.6 0.6 0.6 1</ambient>

            <diffuse>0.8 0.8 0.8 1</diffuse>

            <specular>0.1 0.1 0.1 1</specular>

          </material>

        </visual>

      </link>

    </model>


   
    <model name="end_wall">

      <static>true</static>

      <pose>20 0 1.5 0 0 0</pose>

      <link name="link">

        <collision name="collision">

          <geometry>

            <box>
              <size>0.3 6.6 3</size>
            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>
              <size>0.3 6.6 3</size>
            </box>

          </geometry>


          <material>

            <ambient>0.6 0.6 0.6 1</ambient>

            <diffuse>0.8 0.8 0.8 1</diffuse>

            <specular>0.1 0.1 0.1 1</specular>

          </material>

        </visual>

      </link>

    </model>


    
    <model name="shifting_wall">

      <pose>10 -6 1.5 0 0 0</pose>

      <link name="wall_link">

        <inertial>

          <mass>100</mass>

          <inertia>

            <ixx>50</ixx>
            <iyy>50</iyy>
            <izz>50</izz>

            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>

          </inertia>

        </inertial>


        <collision name="collision">

          <geometry>

            <box>
              <size>0.2 6.0 3</size>
            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>
              <size>0.2 6.0 3</size>
            </box>

          </geometry>


          <material>

            <ambient>0.7 0.7 0.7 1</ambient>

            <diffuse>0.9 0.9 0.9 1</diffuse>

            <specular>0.1 0.1 0.1 1</specular>

          </material>

        </visual>

      </link>

    </model>

  </world>

</sdf>
