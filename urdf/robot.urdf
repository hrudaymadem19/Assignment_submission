<?xml version="1.0"?>

<robot name="slam_robot"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

  
  <xacro:include
    filename="$(find slam_robot_test)/urdf/inertial_macros.xacro"/>

  <!-- Gazebo plugins and sensors -->
  <xacro:include
    filename="$(find slam_robot_test)/urdf/robot.gazebo"/>


  
  <link name="base_footprint"/>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>


  
  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.60 0.40 0.20"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.60 0.40 0.20"/>
      </geometry>
    </collision>

    <xacro:box_inertia
      mass="10.0"
      x="0.60"
      y="0.40"
      z="0.20">

      <origin xyz="0 0 0.15" rpy="0 0 0"/>

    </xacro:box_inertia>

  </link>


 
  <link name="left_wheel">

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
    </collision>

    <xacro:cylinder_inertia
      mass="1.0"
      radius="0.10"
      length="0.05">

      <origin xyz="0 0 0" rpy="1.5708 0 0"/>

    </xacro:cylinder_inertia>

  </link>

  <joint name="left_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="left_wheel"/>

    <origin
      xyz="0 0.225 0.10"
      rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>



  <link name="right_wheel">

    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
    </collision>

    <xacro:cylinder_inertia
      mass="1.0"
      radius="0.10"
      length="0.05">

      <origin xyz="0 0 0" rpy="1.5708 0 0"/>

    </xacro:cylinder_inertia>

  </link>

  <joint name="right_wheel_joint" type="continuous">

    <parent link="base_link"/>
    <child link="right_wheel"/>

    <origin
      xyz="0 -0.225 0.10"
      rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>


 

  <link name="lidar_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
    </visual>

    <xacro:cylinder_inertia
      mass="0.20"
      radius="0.05"
      length="0.05">

      <origin xyz="0 0 0" rpy="0 0 0"/>

    </xacro:cylinder_inertia>

  </link>

  <joint name="lidar_joint" type="fixed">

    <parent link="base_link"/>
    <child link="lidar_link"/>

    <origin xyz="0 0 0.30" rpy="0 0 0"/>

  </joint>


 
  <link name="imu_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.02"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.02"/>
      </geometry>
    </collision>

    <xacro:box_inertia
      mass="0.05"
      x="0.04"
      y="0.04"
      z="0.02">

      <origin xyz="0 0 0" rpy="0 0 0"/>

    </xacro:box_inertia>

  </link>

  <joint name="imu_joint" type="fixed">

    <parent link="base_link"/>
    <child link="imu_link"/>

    <origin xyz="0 0 0.27" rpy="0 0 0"/>

  </joint>


</robot>
